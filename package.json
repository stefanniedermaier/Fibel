{
  "name": "fibel",
  "private": true,
  "version": "0.11.0",
  "license": "MIT",
  "description": "Lern-PWA für Grundschulkinder: Lesen, Schreiben, Rechnen – offline, ohne Server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write src tests e2e scripts .github playwright.config.ts",
    "format:check": "prettier --check src tests e2e scripts .github playwright.config.ts",
    "data:check": "vitest run tests/data.spec.ts",
    "dist:check": "node scripts/check-dist.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "data:openmoji": "node scripts/sync-openmoji.mjs"
  },
  "dependencies": {
    "@fontsource/andika": "^5.3.0",
    "idb": "^8.0.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.8",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "openmoji": "^17.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "editorconfig": {
      "minimatch": "^11.0.9"
    },
    "glob": "^14.0.6"
  }
}
