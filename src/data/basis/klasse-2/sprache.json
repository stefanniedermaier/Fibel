{
  "satzarten": [
    {
      "id": "f1",
      "text": "Wann kommst du nach Hause?"
    },
    {
      "id": "f2",
      "text": "Hast du meinen Ball gesehen?"
    },
    {
      "id": "f3",
      "text": "Wie heißt dein Hund?"
    },
    {
      "id": "f4",
      "text": "Wo liegt mein Stift?"
    },
    {
      "id": "f5",
      "text": "Spielst du mit mir?"
    },
    {
      "id": "f6",
      "text": "Was gibt es heute zum Essen?"
    },
    {
      "id": "f7",
      "text": "Warum ist der Himmel blau?"
    },
    {
      "id": "f8",
      "text": "Kannst du mir helfen?"
    },
    {
      "id": "a1",
      "text": "Pass auf!"
    },
    {
      "id": "a2",
      "text": "Komm schnell her!"
    },
    {
      "id": "a3",
      "text": "Das ist ja toll!"
    },
    {
      "id": "a4",
      "text": "Hör sofort auf!"
    },
    {
      "id": "a5",
      "text": "Vorsicht, das ist heiß!"
    },
    {
      "id": "a6",
      "text": "Wir haben gewonnen!"
    },
    {
      "id": "a7",
      "text": "Mach die Tür zu!"
    },
    {
      "id": "a8",
      "text": "Hurra, es schneit!"
    }
